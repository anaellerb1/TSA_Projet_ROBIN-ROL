   "source": [
    "# paramètres de modulation\n",
    "A   = 5\n",
    "nu0 = 20\n",
    "nu1 = 40\n",
    "\n",
    "# vecteur des instants d’échantillonnage du signal modulé s_m\n",
    "F_mod = 1000\n",
    "T_mod  = 1/F_mod\n",
    "N_mod  = Nb * 100\n",
    "\n",
    "tm = np.arange(N_mod) * T_mod\n",
    "\n",
    "# signal modulé\n",
    "\n",
    "sm = np.array([])\n",
    "for k,val in enumerate(sb):\n",
    "    if val == 0:\n",
    "        sm = np.concatenate((sm, A*np.cos(2*np.pi*nu0*tm[k*100:(k+1)*100])))\n",
    "    if val == 1:\n",
    "        sm = np.concatenate((sm, A*np.cos(2*np.pi*nu1*tm[k*100:(k+1)*100])))\n"
   ]
