    "# signal binarisé\n",
    "dtype = 8 #1.25 int8/s\n",
    "sb = msicpe.tsa.data2bin(s)\n",
    "Nb = N*8            # nombre de points du signal sb, calculé à partir de N et du type des données\n",
    "\n",
    "# vecteur temps correspondant\n",
    "d_bin = 10       # frequence d'echantillonnage du signal binaire\n",
    "tb = np.arange(Nb)/d_bin"
   ]
