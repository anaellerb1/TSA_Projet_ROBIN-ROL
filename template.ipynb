    "N_fixed = 1000\n",
    "\n",
    "for M in [1, 5, 20, None, 100, N_fixed]:\n",
    "    DDPest, c, Delta = histo(b, n=N_fixed, M=M)\n",
    "    std_estim = np.sqrt(DDPth*(1-Delta*DDPth)/(N_fixed*Delta))\n",
    "    compareDDP(c, DDPest, cth, DDPth, std_estim, title='Validation sur le canal test avec N fixe et M variable')"
   ]
  },
