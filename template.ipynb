    "# Affichage de s_b \n",
    "Nbits_to_plot = Nb\n",
    "\n",
    "df_sb = pd.DataFrame({'x': tb[:Nbits_to_plot], 'y': sb[:Nbits_to_plot], 'legende':'sb'})\n",
